rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /kapi_lobby_profiles/{profileId} {
      allow read, write: if true;
    }

    match /kapi_lobby_codes/{code} {
      allow read, write: if true;
    }

    match /kapi_friend_requests/{requestId} {
      allow read, write: if true;
    }

    match /kapi_friendships/{friendshipId} {
      allow read, write: if true;
    }

    match /kapi_game_invites/{inviteId} {
      allow read, write: if true;
    }

    match /kapi_online_games/{gameId} {
      allow read, write: if true;
    }

    match /kapi_player_points/{playerCode} {
      allow read, write: if true;
    }
  }
}
